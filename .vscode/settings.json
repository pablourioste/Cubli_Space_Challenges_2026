{
  // --- LaTeX Workshop: Perl-free build for biblatex + biber ---
  // MiKTeX does not ship Perl, so the default latexmk recipe fails.
  // This recipe runs pdflatex -> biber -> pdflatex -> pdflatex instead.
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOCFILE%"
      ]
    },
    {
      "name": "biber",
      "command": "biber",
      "args": ["%DOCFILE%"]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex x biber x pdflatex x2",
      "tools": ["pdflatex", "biber", "pdflatex", "pdflatex"]
    }
  ],
  "latex-workshop.latex.recipe.default": "first",

  // Build automatically when you save a .tex file
  "latex-workshop.latex.autoBuild.run": "onSave",

  // Keep the project folder tidy: move aux files into a build/ subfolder
  "latex-workshop.latex.outDir": "%DIR%",

  // Auto-clean intermediate files, but keep the PDF
  "latex-workshop.latex.autoClean.run": "onBuilt",
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux", "*.bbl", "*.bcf", "*.blg", "*.idx", "*.ind", "*.lof",
    "*.lot", "*.out", "*.toc", "*.run.xml", "*.fls", "*.fdb_latexmk",
    "*.synctex.gz", "*.log"
  ],

  // Open the PDF in a VS Code tab beside the editor
  "latex-workshop.view.pdf.viewer": "tab"
}
